{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git symbolic-ref *)"
    ],
    "deny": [
      "Bash(gcloud *)",
      "Bash(gsutil *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(rm -rf *)",
      "Bash(cat .env)",
      "Bash(cat .env.local*)",
      "Bash(cat */.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.ai)",
      "Read(**/.env.prod)",
      "Read(**/.env.prod.*)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'd=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; exec \"$d/.claude/statusline.sh\"'",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-secrets.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-edit.sh"
          }
        ]
      }
    ]
  }
}
