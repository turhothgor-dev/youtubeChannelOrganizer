{
  "manifest_version": 3,
  "name": "YouTube Groups",
  "version": "0.1.0",
  "description": "Organiza canales de YouTube en grupos personalizados.",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-groups@turhothgor",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "css": ["content.css"],
      "js": [
        "modules/storage.js",
        "modules/icons.js",
        "modules/groups.js",
        "modules/watched.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
