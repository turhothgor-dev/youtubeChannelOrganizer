{
  "manifest_version": 3,
  "name": "YouTube Groups",
  "version": "0.1.0",
  "description": "Organiza canales de YouTube en grupos personalizados.",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-groups@turhothgor",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "css": [
        "ui/panel.css",
        "ui/cards.css",
        "ui/dropdowns.css",
        "ui/buttons.css",
        "ui/icons.css",
        "ui/icon-picker.css",
        "ui/guide-section.css",
        "ui/fullscreen.css"
      ],
      "js": [
        "modules/storage.js",
        "modules/fxemoji-data.js",
        "modules/icons.js",
        "modules/groups.js",
        "modules/watched.js",
        "modules/settings.js",
        "modules/visibility.js",
        "modules/metadata.js",
        "modules/pages.js",
        "modules/filter.js",
        "modules/guide.js",
        "modules/playlists.js",
        "modules/backup.js",
        "ui/icons-dom.js",
        "ui/icon-picker.js",
        "ui/dropdowns.js",
        "ui/player.js",
        "ui/watched.js",
        "ui/cards.js",
        "ui/guide-section.js",
        "ui/panel.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
